# Copy required values into .env; keep your existing TOKEN/API_URL.
TOKEN=replace-with-a-long-random-token
API_URL=http://127.0.0.1:7403
# Only for explicitly unauthenticated local development:
ALLOW_UNAUTHENTICATED=0
LOCAL_BACKEND=sqlite
SERVER_BACKEND=sqlite
# DATABASE_PATH=face_embeddings.db
SEARCH_METRIC=cosine
SEARCH_TOLERANCE=0.07
FACE_ENCODER=dlib
# MODEL_PATH=runs/siamese-.../best.pth
NUM_JITTERS=10
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MAX_FACES=20
MAX_RESULTS=100
# CRAWLER_DATABASE_PATH=face_embeddings.db
CRAWLER_DOWNLOAD_WORKERS=3
CRAWLER_PREVIEW_WIDTH=960
CRAWLER_REQUEST_INTERVAL=0.5
CRAWLER_REFRESH_HOURS=24
CRAWLER_BACKUP_HOURS=24
CRAWLER_MIN_FREE_MB=512
# Defaults to NUM_JITTERS, preserving encoder quality. Optional faster encoding:
# CRAWLER_NUM_JITTERS=1
# USER_AGENT=FaceSearchBot/2.0 (your project URL or contact)
